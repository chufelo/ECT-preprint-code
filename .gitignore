# Canonical sources are never ignored. Only generated or historical variants are.

# Retired attachment-copy workflow and explicit backup variants.
* copy*
*.bak
*.bak_*
*.bak-*
*_BACKUP*
*.BROKEN_*

# LaTeX/build products. Canonical publication PDFs and committed BBL files that
# are already tracked remain tracked despite these patterns.
*.aux
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv
texput.log
/.build/

# Local environments, caches, editor files, and generated previews.
/scripts/.venv/
__pycache__/
*.py[cod]
.DS_Store
*.swp
*~
_*.marker
/figures/*preview*
/figures/*draft*
/figures/*OLD*

# Private/deferred/history material. Named R* candidates are reviewed and
# applied to canonical paths; the candidate packages themselves are not public
# repository payload.
/book/
/backup/
/.archive/
/work/preprint/R*/
/work/preprint/drafts/
/work/preprint/proposals/

# Optional local validator output. The frozen PDF manifest is intentionally not
# ignored and may be committed after independent review.
/release/zenodo/R*/VALIDATION_REPORT.runtime.json
