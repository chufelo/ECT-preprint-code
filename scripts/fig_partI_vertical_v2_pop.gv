digraph PartIpop {
  rankdir=TB;
  pad="0.2";
  margin="0";
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", margin="0.10,0.05"];
  edge [fontname="Helvetica", fontsize=8];
  splines=true;
  nodesep=0.20;
  ranksep=0.25;
  newrank=true;
  labeljust=c;

  // === POSTULATES ===
  node [fillcolor="#404040", fontcolor=white];
  P1 [label=<P1<BR/>4D Euclidean>];
  P2 [label=<P2<BR/>O(4) action>];
  P3 [label=<P3<BR/>Condensate Φ>];
  P4 [label=<P4<BR/>Gradient cond.>];
  P5 [label=<P5<BR/>Medium<BR/>character>];
  P6 [label=<P6<BR/>Non-uniform<BR/>ordering>];

  // === PHENOMENOLOGICAL INPUTS ===
  node [fillcolor="#808080", fontcolor=white];
  Ph2 [label=<Ph2<BR/>M<SUB>G</SUB> = M̄<SUB>Pl</SUB> (obs.)>];
  Ph1 [label=<Ph1<BR/>c* = c (structural)<BR/>Level B>];

  // === LEVEL A ===
  node [fillcolor="#b8b8b8", fontcolor=black];
  SSB [label=<SSB<BR/>O(4)→O(3), selects w>];
  UC [label=<Universality Corollary<BR/>one Φ → one K<SUP>AB</SUP> → one cone>];
  lorentz [label=<Lorentzian<BR/>metric>];
  goldstone [label=<3 Goldstone<BR/>bosons (fuzzy DM)>];
  cstar [label=<c* = √(β/(α−β))<BR/>Grav. const.>];
  PX [label=<P(X) theorem<BR/>no orientation stiffness<BR/>Level A>];
  KG [label=<Klein–Gordon<BR/>equation>];
  topo_anti [label=<Topological anti-predictions<BR/>π<SUB>0</SUB> = π<SUB>1</SUB> = π<SUB>2</SUB> = 0<BR/>No walls / strings / monopoles>];
  gauge [label=<Gauge architecture<BR/>U(1) bundle (A) · SU(2) structural (B+)>];
  schrodinger [label=<Schrödinger<BR/>equation<BR/>QS>];

  // === LEVEL B ===
  node [fillcolor="#ffffff", fontcolor=black];
  NLO [label=<NLO/induced stiffness<BR/>κ<SUB>n</SUB> = C<SUB>n</SUB> u<SUB>0</SUB>²<BR/>M<SUB>G</SUB>² ~ φ<SUB>0</SUB>²<BR/>Level B>];
  hbar [label=<ℏ = S<SUB>loop</SUB>/2π<BR/>Planck const.>];
  GE [label=<Euclidean corr.<BR/>G<SUB>E</SUB>(X, X′)>];
  GN [label=<G<SUB>N</SUB> = c*<SUP>4</SUP>/(8π M<SUB>G</SUB>²)<BR/>Grav. const.>];
  einstein [label=<Einstein eqs.<BR/>(linearised)>];
  dirac [label=<Dirac eq.>];
  second_law [label=<2nd law of<BR/>thermodynamics>];
  fifth [label=<Director coupling<BR/>μ₅ψ̄γ<SUP>A</SUP>n<SUB>A</SUB>ψ>];
  skyrmion [label=<Skyrmion / texture sectors<BR/>π<SUB>3</SUB>(S³) = ℤ<BR/>m<SUB>n</SUB> ~ n × 1.6 GeV<BR/>(legacy; secondary-sector route open)>];
  LIV [label=<Planck-scale LIV<BR/>|δc/c| &lt; 10<SUP>−15</SUP>>];
  neutrino [label=<Neutrino sector<BR/>one-chiral weak route (B)<BR/>embedded neutrino preferred (C)<BR/>M<SUB>R</SUB><SUP>geom</SUP> = √(φ<SUB>0</SUB> v<SUB>2</SUB>)<BR/>PMNS intact; 0νββ discr.>];
  unruh [label=<Unruh effect<BR/>T<SUB>U</SUB>=ℏa/(2πc*k<SUB>B</SUB>)<BR/>QS>];

  // === OPEN ===
  node [fillcolor="white", style="rounded,dashed", fontcolor=black, penwidth=2];
  SU3 [label=<SU(3)<SUB>c</SUB> [OPEN]<BR/>dim su(3)=8 &gt; 6=dim so(4)<BR/>requires extended structure>];
  threegen [label=<3 generations<BR/>[OPEN]>];
  cpt_open [label=<Discrete-symmetry · Anomaly · Flavour opens<BR/>OP-CPT1 · full nonlinear CPT<BR/>OP-P1 · exact max parity<BR/>OP-BRANCH1 · branch-pair cosmology<BR/>OP-GUT6c · mixed U(1)-grav (emergent)<BR/>OP-Yukawa · CKM/PMNS/CP phases/ν spectrum>];

  // === NEW NODES from unification integration ===
  node [fillcolor="#b8b8b8", fontcolor=black];
  parity [label=<Parity violation<BR/>Oriented condensate<BR/>→ SU(2)<SUB>L</SUB> selected>];

  node [fillcolor="#ffffff", fontcolor=black];
  boson_hier [label=<Hierarchical boson<BR/>spectrum (4 levels)>];
  common_origin [label=<Common pre-geometric<BR/>origin of interactions>];
  cpt_arch [label=<Discrete-symmetry<BR/>architecture<BR/>P, T, C · conditional CPT<BR/>via OS reconstruction<BR/>Branch-pair on S³<BR/>𝓛₅ → CPT-odd phenom. op.>];
  anomaly_arch [label=<Anomaly architecture<BR/>EW conditions verified, inherited content (A)<BR/>𝓛₅ transparency lemma · solution structure ·<BR/>N<SUB>c</SUB> classification (A cand.)<BR/>Emergent-graviton role Open (OP-GUT6c)>];
  flavour_arch [label=<Flavour architecture<BR/>CKM from overlap misalignment<BR/>PMNS from overlap + seesaw<BR/>Near-alignment of flavour rotations<BR/>CP phases in Yukawa / Majorana sector<BR/>Numerical Open under OP-Yukawa>];

  // === RANKS (portrait restructuring: narrow tiers, chains unstacked) ===
  {rank=same; P1; P2; P3; P4}
  {rank=same; P5; P6; Ph1; Ph2}
  {rank=same; PX; hbar; GE}
  {rank=same; NLO; lorentz; goldstone; cstar}
  {rank=same; GN; KG; unruh}
  {rank=same; gauge; einstein; schrodinger}
  {rank=same; parity; dirac; second_law}
  {rank=same; fifth; neutrino}
  {rank=same; SU3; threegen}
  {rank=same; cpt_arch; common_origin; boson_hier}
  {rank=same; anomaly_arch; LIV}
  {rank=same; flavour_arch; topo_anti}
  {rank=same; skyrmion; cpt_open}

  // === in-rank ordering (invisible flat edges) ===
  P1 -> P2 [style=invis]; P2 -> P3 [style=invis]; P3 -> P4 [style=invis];
  P5 -> P6 [style=invis]; P6 -> Ph1 [style=invis]; Ph1 -> Ph2 [style=invis];
  fifth -> neutrino [style=invis];
  SU3 -> threegen [style=invis];
  neutrino -> SU3 [style=invis];
  threegen -> boson_hier [style=invis];
  dirac -> parity [style=invis]; parity -> second_law [style=invis];
  LIV -> anomaly_arch [style=invis];
  boson_hier -> common_origin [style=invis]; common_origin -> cpt_arch [style=invis];
  topo_anti -> flavour_arch [style=invis];
  skyrmion -> cpt_open [style=invis];

  // === tier ordering (invisible) ===
  P2 -> P6 [style=invis];
  P3 -> Ph1 [style=invis];

  // === EDGES ===
  P1 -> SSB; P2 -> SSB; P3 -> SSB; P4 -> SSB;
  P6 -> SSB [style=dashed];
  SSB -> UC [weight=8];
  UC -> lorentz [weight=8]; UC -> goldstone; UC -> cstar; UC -> hbar;
  UC -> PX;
  PX -> NLO;
  NLO -> GN [style=dashed];
  lorentz -> KG; lorentz -> einstein;
  P5 -> gauge;
  lorentz -> gauge [weight=8];
  cstar -> GN; GN -> einstein;
  SSB -> topo_anti [weight=0]; SSB -> skyrmion [weight=0];
  P6 -> topo_anti [style=dashed, weight=0];
  P6 -> skyrmion [style=dashed, weight=0];
  gauge -> dirac [weight=8];
  dirac -> fifth; dirac -> neutrino;
  gauge -> neutrino [weight=0];
  einstein -> second_law;
  cstar -> LIV [weight=0]; GN -> LIV [weight=0];
  KG -> schrodinger;
  lorentz -> unruh [style=dashed, weight=0];
  hbar -> KG [style=dashed, weight=0];

  Ph1 -> cstar [style=dashed];
  Ph2 -> NLO [style=dashed, weight=0];
  P3 -> GE [style=dashed, weight=0];
  P4 -> lorentz [style=dashed];
  SSB -> GE [style=dashed, weight=0];
  gauge -> SU3 [style=dashed, color=black, weight=0];
  gauge -> threegen [style=dashed, color=black, weight=0];

  // === NEW EDGES ===
  gauge -> parity;
  gauge -> common_origin [style=dashed, weight=0];
  parity -> common_origin [style=dashed];
  fifth -> common_origin [style=dashed];
  gauge -> boson_hier [style=dashed, weight=0];
  goldstone -> boson_hier [style=dashed, weight=0];

  // === F3: Discrete-symmetry architecture edges ===
  parity -> cpt_arch [weight=8];
  fifth -> cpt_arch;
  gauge -> cpt_arch [style=dashed, weight=0];
  cpt_arch -> cpt_open [style=dashed];
  // === F4: Anomaly architecture edges ===
  cpt_arch -> anomaly_arch [weight=8];
  gauge -> anomaly_arch [weight=0];
  anomaly_arch -> cpt_open [style=dashed];
  // === F8: Flavour architecture edges ===
  anomaly_arch -> flavour_arch [weight=8];
  dirac -> flavour_arch [weight=0];
  flavour_arch -> cpt_open [style=dashed, weight=8];

  // === LEGEND ===
  node [shape=plaintext, style="", fillcolor=white];
  legend [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="4" CELLPADDING="6" COLOR="black">
      <TR><TD COLSPAN="4"><B>Legend</B></TD></TR>
      <TR>
        <TD BGCOLOR="#404040"><FONT COLOR="white">Postulate (P1–P6)</FONT></TD>
        <TD BGCOLOR="#808080"><FONT COLOR="white">Phenom. input</FONT></TD>
        <TD BGCOLOR="#b8b8b8">Derived – Level A</TD>
        <TD BGCOLOR="#ffffff" BORDER="1">Derived – Level B</TD>
      </TR>
      <TR>
        <TD BORDER="1" STYLE="DASHED">Open problem</TD>
        <TD>——→ Strict derivation</TD>
        <TD COLSPAN="2">– – → Requires assumptions</TD>
      </TR>
    </TABLE>
  >];
  skyrmion -> legend [style=invis];
  cpt_open -> legend [style=invis];
}
