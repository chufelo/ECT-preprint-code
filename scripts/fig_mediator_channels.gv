digraph MediatorChannels {
  rankdir=TB;
  fontname="Helvetica";
  pad="0.2";
  node [fontname="Helvetica", fontsize=10, shape=box,
        style="rounded,filled", margin="0.14,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="black"];
  splines=true;
  nodesep=0.35;
  ranksep=0.75;
  labeljust=c;

  node [fillcolor="#404040", fontcolor=white];
  root [label=<<B>Candidate reduced gravitational channels in ECT</B><BR/>
              response, projection and state/noise kept distinct>];

  node [fillcolor="#b8b8b8", fontcolor=black];
  phi_ch [label=<<B>&#x03C6;-channel</B>&#x2003;&#x2014;&#x2003;canonical trace response<BR/>
                matter vertex PARAMETRIC ONLY<BR/>
                ECT state/noise kernel NOT IDENTIFIABLE>];
  delta_ch [label=<<B>&#x03B4;n<SUB>A</SUB>-channel</B>&#x2003;&#x2014;&#x2003;orientation / tensor<BR/>
                  linear static-density vertex removed by physical projection<BR/>
                  alternative retarded/nonlinear channel Open>];

  node [fillcolor="#d8d8d8", fontcolor=black];
  mixed_ch [label=<<B>Mixed scalar&#x2013;orientation sector</B><BR/>
                    cross-response and state/noise dressing Open>];

  node [fillcolor="#ffffff", fontcolor=black];
  dp_bench [label=<Imported Di&#xF3;si&#x2013;Penrose benchmark<BR/>
                   &#x03C4;<SUB>DP</SUB><SUP>bench</SUP> &#x223C; &#x210F;R/(G<SUB>N</SUB>m&#xB2;)<BR/>
                   NOT an ECT-derived rate>, style="rounded,dashed,filled", penwidth=2];
  m_guide [label=<Benchmark-derived experimental guide<BR/>
                 m<SUB>guide</SUB> &#x223C; &#x221A;(&#x210F;R/(G<SUB>N</SUB>&#x03C4;<SUB>exp</SUB>))<BR/>
                 not an ECT crossover>];
  entangling [label=<Alternative orientation/tensor<BR/>
                     entangling mediator<BR/>Open>];
  orient_ts [label=<Orientation-sector timescale<BR/>
                    Open / NOT IDENTIFIABLE>];

  node [fillcolor="#ffffff", fontcolor=black, style="rounded,dashed,filled",
        penwidth=2];
  op_q22 [label=<<B>OP-Q22</B>&#x2003;&#x03B4;n<SUB>A</SUB> entangling mediator<BR/>
                  requires a covariant orientation action,<BR/>
                  physical projection and influence-functional state>];

  {rank=same; root}
  {rank=same; phi_ch; delta_ch; mixed_ch}
  {rank=same; dp_bench; entangling}
  {rank=same; m_guide; orient_ts}
  {rank=same; op_q22}

  root -> phi_ch [style=dashed, label="parametric"];
  root -> delta_ch [style=dashed, label="projection gate"];
  root -> mixed_ch [style=dashed, label="mixed channel Open"];
  phi_ch -> dp_bench [style=dashed,
                      label="benchmark comparator; no derivation"];
  dp_bench -> m_guide [label="benchmark algebra"];
  delta_ch -> entangling [style=dashed];
  entangling -> orient_ts [style=dashed];
  orient_ts -> op_q22 [style=dashed];
  m_guide -> entangling [style=dashed,
                         label="benchmark guide cannot replace orientation channel"];
  mixed_ch -> entangling [style=dashed];
}
