digraph PartII {
  rankdir=TB;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", margin="0.09,0.05"];
  edge [fontname="Helvetica", fontsize=8, color="black", penwidth=1.0];
  splines=true;
  nodesep=0.12;
  ranksep=0.08;
  newrank=true;
  labeljust=c;
  ratio="1.20";

  // LEVEL A (structural, light grey)
  node [fillcolor="#b8b8b8"];
  partI [label=<Part I outputs<BR/>(P1–P6, BR1, DP)<BR/>§§2–10>, fontsize=10];
  sr [label=<Special Relativity<BR/>ds² = η<SUB>μν</SUB> dX<SUP>μ</SUP> dX<SUP>ν</SUP><BR/>§12>];
  metric [label=<Effective metric<BR/>diag(β,β,β,−(α−β))<BR/>§13.1>];
  source [label=<Conserved source<BR/>∂<SUB>A</SUB> T<SUP>AB</SUP> = 0<BR/>§13.3>];
  cgw [label=<GW speed c<SUB>GW</SUB> = c*<BR/>GW170817 ✓<BR/>§13.8>];
  weakfield [label=<Screened Newtonian<BR/>limit<BR/>§13.6>];
  flatness [label=<k = 0<BR/>(P1 + macrocoh.)<BR/>§14.3>];
  monopole [label=<π<SUB>2</SUB>(S³) = 0<BR/>no primary monopoles<BR/>§14.4>];
  scalar_mode [label=<Single scalar<BR/>perturb. mode<BR/>§14.5>];
  cc_catastrophe [label=<CC catastrophe<BR/>resolved (Level A)<BR/>V(φ<SUB>0</SUB>) inert via<BR/>√(−g<SUB>eff</SUB>)=β²/c*<BR/>Thm 1, §15>];

  // LEVEL B (closure, white)
  node [fillcolor="#ffffff"];
  bridge [label=<Bridge §11<BR/>Inherited inputs<BR/>(β &lt; α &lt; 4β, c*, u<SUB>0</SUB>, K<SUP>AB</SUP>)>];
  GN [label=<G<SUB>N</SUB> matching<BR/>G<SUB>N</SUB> = c*<SUP>4</SUP>/(8π M<SUB>G</SUB>²)<BR/>§13.4>];
  closure [label=<Nonlinear φ-closure §13.5<BR/>GEE: G<SUB>eff</SUB>, Λ<SUB>eff</SUB>, Θ<SUB>μν</SUB>>];
  closure_funcs [label=<Closure functions §13.5<BR/>F=exp(βφ), ω=ω<SUB>0</SUB>exp(2βφ)<BR/>U=W(u<SUB>∞</SUB> exp(βφ))>];
  nophantom [label=<No-phantom bound<BR/>w(z) ≥ −1<BR/>§15.1>];
  hubble [label=<Retained ε band<BR/>ε ∈ [0.0296, 0.0376]<BR/>§15.5>];
  jwst [label=<JWST extraction<BR/>ε<SUB>JWST</SUB> binds band<BR/>§15.5>];
  age [label=<Age apparatus<BR/>t<SUB>0</SUB> ≈ 13.5 Gyr<BR/>§15.4>];
  baryogenesis [label=<Sakharov-compat.<BR/>baryogenesis env.<BR/>(compatibility)<BR/>§15.3>];
  rotcurves [label=<Rotation curves<BR/>165 SPARC gal.<BR/>§16.3>];
  btfr [label=<BTFR slope 4<BR/>§16.3>];
  rar [label=<RAR σ ≈ 0.13 dex<BR/>§16.4>];
  gdagger [label=<g<SUP>†</SUP><SUB>0</SUB> = cH<SUB>0</SUB>/(2π)<BR/>≈ 1.04×10⁻¹⁰ m/s²<BR/>§16.3>];
  envmod [label=<Environmental<BR/>modulation g<SUP>†</SUP><SUB>eff</SUB><BR/>(F1) §16.1>];
  cluster [label=<Cluster lensing<BR/>Bullet+3 (F10)<BR/>§16.2>];
  darkDM [label=<No particle DM<BR/>galactic §17.2>];
  darkDE [label=<DE = ordered-branch<BR/>background §17.3>];
  branch_orient [label=<Branch orientation (OP3.2)<BR/>T-reversal covariance (A)<BR/>+ cond. persistence (B)<BR/>§14.2>];
  tests [label=<13 Falsifiers<BR/>F1–F13 §18.1>, fontsize=10, penwidth=1.5];

  // OPEN
  node [fillcolor="white", style="rounded,dashed,filled", penwidth=1.5];
  open_eft [label=<EFT parameters<BR/>Z<SUB>u</SUB>, W(u), β<BR/>OP-grad>];
  open_ns [label=<ECT-native n<SUB>s</SUB>, r<BR/>OP3>];
  open_fractions [label=<Cosmological<BR/>fraction budget>];
  open_phi_bvp [label=<Full φ BVP solver>];
  cc_ir [label=<ρ<SUB>Λ</SUB>~c<SUB>Λ</SUB> M<SUB>Pl</SUB>²H<SUB>0</SUB>²<BR/>(Level C, §15.8)<BR/>Goldstone cand.<BR/>§15.9>];

  // RANKS (portrait: max 2 nodes per rank)
  {rank=same; partI}
  {rank=same; bridge}
  {rank=same; sr; metric}
  {rank=same; source; cgw}
  {rank=same; GN}
  {rank=same; closure}
  {rank=same; closure_funcs; weakfield}
  {rank=same; flatness; monopole; cc_catastrophe}
  {rank=same; scalar_mode; baryogenesis}
  {rank=same; nophantom; hubble}
  {rank=same; branch_orient}
  {rank=same; age; jwst}
  {rank=same; gdagger}
  {rank=same; rotcurves}
  {rank=same; btfr; rar}
  {rank=same; envmod}
  {rank=same; cluster; darkDM}
  {rank=same; darkDE}
  {rank=same; tests}
  {rank=same; open_eft; open_ns}
  {rank=same; open_fractions; open_phi_bvp; cc_ir}

  // EDGES — preserved from audited Part II graph
  partI -> bridge [style=bold, penwidth=2];
  bridge -> sr; bridge -> metric; bridge -> source;
  metric -> GN; metric -> cgw;
  sr -> closure;
  metric -> closure;
  {GN; source} -> closure;
  closure -> closure_funcs; closure -> weakfield;
  weakfield -> rotcurves;
  closure -> flatness;
  partI -> flatness [style=dashed];
  partI -> monopole;
  closure -> monopole [style=dashed];
  closure -> scalar_mode;
  closure_funcs -> nophantom;
  closure_funcs -> hubble;
  closure_funcs -> age;
  {hubble; age} -> jwst;
  closure -> baryogenesis [style=dashed];
  partI -> baryogenesis [style=dashed];
  rotcurves -> btfr; rotcurves -> rar;
  weakfield -> gdagger;
  gdagger -> envmod;
  gdagger -> rotcurves;
  {rotcurves; envmod} -> cluster;
  {rotcurves; envmod} -> darkDM;
  {nophantom; hubble} -> darkDE;
  closure_funcs -> branch_orient;
  partI -> branch_orient [style=dashed];
  branch_orient -> darkDE [style=dashed];
  {darkDM; darkDE; envmod; cluster; cgw} -> tests;
  gdagger -> tests;
  btfr -> tests;
  rar -> tests;
  age -> tests;
  jwst -> tests;
  baryogenesis -> tests;
  closure_funcs -> open_eft [style=dashed];
  scalar_mode -> open_ns [style=dashed];
  darkDE -> open_fractions [style=dashed];
  rotcurves -> open_phi_bvp [style=dashed];

  // CC catastrophe & IR estimate (§15)
  metric -> cc_catastrophe;
  bridge -> cc_catastrophe;
  cc_catastrophe -> cc_ir [style=dashed];
  closure_funcs -> cc_ir [style=dashed];
  cc_catastrophe -> tests;
  cc_ir -> tests [style=dashed];

  // LEGEND (placed right next to final open nodes)
  node [shape=plaintext, style="", fillcolor=white];
  legend [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="3" CELLPADDING="5" COLOR="black">
      <TR><TD COLSPAN="3"><B>Legend — Part II derivation logic</B></TD></TR>
      <TR>
        <TD BGCOLOR="#b8b8b8">Structural / Level A</TD>
        <TD BGCOLOR="#ffffff" BORDER="1">Closure / Level B</TD>
        <TD BORDER="1" STYLE="DASHED">Open</TD>
      </TR>
      <TR>
        <TD><B>Solid arrow:</B> strict derivation</TD>
        <TD COLSPAN="2"><B>Dashed arrow:</B> assumption / inherited / matching</TD>
      </TR>
    </TABLE>
  >];
  {rank=same; legend; tests}
  legend -> tests [style=invis, weight=100];
}
