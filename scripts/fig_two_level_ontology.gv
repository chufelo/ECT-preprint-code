digraph FullReducedStatus {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#eeeeee", color="#333333", fontname="Helvetica", fontsize=11];
  edge [color="black", fontname="Helvetica", fontsize=9];
  full [label="Full condensate candidate description\ninteracting OS/unitarity completion Open", penwidth=2];
  split [label="Declared resolved/unresolved split\nphysical vertices + state + protocol required"];
  coherent [label="Coherence-retaining reduced channel\nsmall Phi_ab for declared comparisons"];
  records [label="Record-forming reduced channel\nlarge Phi_ab for declared comparisons"];
  outcome [label="Unique outcome / update rule\nOpen (OP-Q19)", style="rounded,filled,dashed"];
  mediator [label="Gravity-mediator/GIE status\nrequires its own derived vertex and channel", style="rounded,filled,dashed"];
  guard [label="No universal metric-signature or ontology transition from Phi_ab", fillcolor="#dddddd"];
  full -> split;
  split -> coherent;
  split -> records;
  records -> outcome [style=dashed];
  split -> mediator [style=dashed];
  coherent -> guard;
  records -> guard;
}
